    },
    {
      'level': 2,
      'emoji': '😊🙏🌈',
      'label': 'Happy & Connected',
      'color': Color(0xFFFFD700),
      'description': 'Feeling courageous, enthusiastic, and appreciative'
    },
    {
      'level': 1,
      'emoji': '😌🌞👍',
      'label': 'Hopeful & Confident',
      'color': Color(0xFF98FB98),
      'description': 'Feeling optimistic, inspired, and positive'
    },
    {
      'level': 0,
      'emoji': '😐⚖️',
      'label': 'Content & Balanced',
      'color': Color(0xFFB0B0B0),
      'description': 'Feeling satisfied and peaceful'
    },
    {
      'level': -1,
      'emoji': '😔😟',
      'label': 'Disappointed & Worried',
      'color': Color(0xFFFFB6C1),
      'description': 'Feeling disappointed, doubtful, or frustrated'
    },
    {
      'level': -2,
      'emoji': '😠😨',
      'label': 'Angry & Anxious',
      'color': Color(0xFFFF4500),
      'description': 'Feeling anxious, angry, or resentful'
    },
